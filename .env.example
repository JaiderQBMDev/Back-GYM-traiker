# Supabase project settings → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Comma-separated list of origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

PORT=4000
NODE_ENV=development

# NOTE: the service_role key is intentionally NOT used by this service.
# Every request is executed as the authenticated user (their JWT), so
# Postgres Row Level Security is what actually enforces access control.
# Never put the service_role key in this file or in any runtime env var
# that a deployed server reads on every request — it bypasses RLS entirely.
